---
import '../styles/global.css';
import Icon from '../components/ui/Icon.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'SiteSage — Intelligent Construction Safety Command Center',
  description = 'See your site. Detect risks. Act faster. SiteSage turns standard construction cameras into an automated safety intelligence system.'
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&family=Manrope:wght@600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <!-- Skip to main accessible link -->
    <a href="#main-content" class="skip-link">Skip to operational content</a>

    <!-- Subtle Blue Cursor-Following Dot (Desktop Pointer Only) -->
    <div id="cursor-dot" aria-hidden="true"></div>

    <!-- Minimal Landing Header -->
    <header class="marketing-header">
      <div class="header-inner">
        <a href="/" class="brand-logo" aria-label="SiteSage Home">
          <div class="brand-mark">
            <span class="pulse-ring"></span>
            <Icon name="shield-alert" size={20} color="#3B82F6" />
          </div>
          <div class="brand-text">
            <span class="brand-title">SITESAGE</span>
            <span class="brand-badge">SAFETY AI</span>
          </div>
        </a>

        <nav class="nav-links" aria-label="Primary Marketing Navigation">
          <a href="#how-it-works" class="nav-link">How It Works</a>
          <a href="#capabilities" class="nav-link">Vision AI</a>
          <a href="#spatial" class="nav-link">Spatial Intelligence</a>
          <a href="/dashboard" class="nav-link nav-highlight">Live Command Center</a>
        </nav>

        <div class="header-actions">
          <a href="/login" class="btn btn-ghost btn-sm">Sign In</a>
          <a href="/dashboard" class="btn btn-primary btn-sm">
            Launch Platform
            <Icon name="arrow-right" size={14} />
          </a>
        </div>
      </div>
    </header>

    <main id="main-content">
      <slot />
    </main>

    <!-- Operational Footer -->
    <footer class="marketing-footer">
      <div class="footer-inner">
        <div class="footer-brand">
          <div class="brand-text">
            <span class="brand-title">SITESAGE</span>
            <span class="footer-tagline">See your site. Detect risks. Act faster.</span>
          </div>
          <p class="text-caption" style="margin-top: 8px; max-width: 380px;">
            Purpose-built computer vision safety intelligence for high-hazard industrial jobsites. Zero facial recognition. 100% privacy-first aggregate risk mitigation.
          </p>
        </div>

        <div class="footer-cols">
          <div class="footer-col">
            <h4 class="text-metadata">Platform</h4>
            <a href="/dashboard">Command Center</a>
            <a href="/live-monitoring">Live Monitoring</a>
            <a href="/incidents">Incident Management</a>
            <a href="/reports">Compliance Reports</a>
          </div>
          <div class="footer-col">
            <h4 class="text-metadata">Safety Systems</h4>
            <a href="/cameras">Camera Management</a>
            <a href="/zones">Zone Geofencing</a>
            <a href="/system-states">State Health Matrix</a>
          </div>
          <div class="footer-col">
            <h4 class="text-metadata">Trust & Privacy</h4>
            <span class="trust-badge"><Icon name="shield-check" size={14} color="#10B981" /> ISO 27001 Edge Processing</span>
            <span class="trust-badge"><Icon name="shield-check" size={14} color="#10B981" /> No Facial Recognition</span>
            <span class="trust-badge"><Icon name="shield-check" size={14} color="#10B981" /> Anonymized Worker ID</span>
          </div>
        </div>
      </div>

      <div class="footer-bottom">
        <p class="text-caption">© 2026 SiteSage Technologies Inc. All rights reserved. Simulated construction telemetry environment.</p>
        <div class="system-status-indicator">
          <span class="badge-dot" style="background: var(--color-safe);"></span>
          <span class="text-metadata">EDGE CLUSTER: US-EAST-01 (ACTIVE)</span>
        </div>
      </div>
    </footer>

    <!-- Client-side Cursor and Motion Handler -->
    <script>
      // Desktop Cursor Dot
      const cursorDot = document.getElementById('cursor-dot');
      if (cursorDot && window.matchMedia('(pointer: fine)').matches) {
        let mouseX = 0, mouseY = 0;
        let dotX = 0, dotY = 0;

        window.addEventListener('mousemove', (e) => {
          mouseX = e.clientX;
          mouseY = e.clientY;
          cursorDot.style.opacity = '1';
        }, { passive: true });

        window.addEventListener('mouseleave', () => {
          cursorDot.style.opacity = '0';
        });

        const render = () => {
          dotX += (mouseX - dotX) * 0.2;
          dotY += (mouseY - dotY) * 0.2;
          cursorDot.style.left = `${dotX}px`;
          cursorDot.style.top = `${dotY}px`;
          requestAnimationFrame(render);
        };
        requestAnimationFrame(render);
      }
    </script>

    <style>
      .skip-link {
        position: absolute;
        top: -40px;
        left: 10px;
        background: var(--color-info);
        color: #fff;
        padding: 8px 16px;
        z-index: 9999;
        transition: top 0.2s;
        font-weight: 600;
        border-radius: var(--radius-sm);
      }
      .skip-link:focus {
        top: 10px;
      }
      .marketing-header {
        position: sticky;
        top: 0;
        z-index: var(--z-header);
        background: rgba(11, 18, 32, 0.88);
        backdrop-filter: blur(12px);
        border-bottom: 1px solid var(--color-border);
        height: 64px;
        display: flex;
        align-items: center;
      }
      .header-inner {
        width: 100%;
        max-width: 1400px;
        margin: 0 auto;
        padding: 0 var(--space-6);
        display: flex;
        align-items: center;
        justify-content: space-between;
      }
      .brand-logo {
        display: flex;
        align-items: center;
        gap: var(--space-3);
      }
      .brand-mark {
        position: relative;
        width: 32px;
        height: 32px;
        border-radius: var(--radius-md);
        background: var(--color-surface-elevated);
        border: 1px solid var(--color-info-border);
        display: flex;
        align-items: center;
        justify-content: center;
      }
      .brand-text {
        display: flex;
        align-items: center;
        gap: var(--space-2);
      }
      .brand-title {
        font-family: var(--font-display);
        font-weight: 800;
        letter-spacing: 0.08em;
        font-size: var(--font-size-md);
        color: #FFFFFF;
      }
      .brand-badge {
        font-family: var(--font-mono);
        font-size: var(--font-size-2xs);
        padding: 2px 6px;
        background: var(--color-info-bg);
        border: 1px solid var(--color-info-border);
        color: var(--color-info-light);
        border-radius: var(--radius-xs);
      }
      .nav-links {
        display: flex;
        align-items: center;
        gap: var(--space-6);
      }
      .nav-link {
        font-size: var(--font-size-sm);
        color: var(--color-text-secondary);
        font-weight: 500;
        transition: color var(--duration-fast);
      }
      .nav-link:hover {
        color: #FFFFFF;
      }
      .nav-highlight {
        color: var(--color-info-light);
        font-weight: 600;
      }
      .header-actions {
        display: flex;
        align-items: center;
        gap: var(--space-3);
      }
      .marketing-footer {
        background: var(--color-bg-alt);
        border-top: 1px solid var(--color-border);
        padding: var(--space-12) var(--space-6) var(--space-6);
        margin-top: var(--space-16);
      }
      .footer-inner {
        max-width: 1400px;
        margin: 0 auto;
        display: flex;
        justify-content: space-between;
        gap: var(--space-10);
        flex-wrap: wrap;
      }
      .footer-tagline {
        font-size: var(--font-size-sm);
        color: var(--color-text-secondary);
        font-style: italic;
      }
      .footer-cols {
        display: flex;
        gap: var(--space-12);
        flex-wrap: wrap;
      }
      .footer-col {
        display: flex;
        flex-direction: column;
        gap: var(--space-2);
      }
      .footer-col a {
        font-size: var(--font-size-sm);
        color: var(--color-text-secondary);
        transition: color var(--duration-fast);
      }
      .footer-col a:hover {
        color: var(--color-text-primary);
      }
      .trust-badge {
        font-size: var(--font-size-xs);
        color: var(--color-text-muted);
        display: flex;
        align-items: center;
        gap: 6px;
      }
      .footer-bottom {
        max-width: 1400px;
        margin: var(--space-8) auto 0;
        padding-top: var(--space-4);
        border-top: 1px solid var(--color-border-subtle);
        display: flex;
        align-items: center;
        justify-content: space-between;
      }
      .system-status-indicator {
        display: flex;
        align-items: center;
        gap: 6px;
      }

      @media (max-width: 768px) {
        .nav-links {
          display: none;
        }
        .footer-inner {
          flex-direction: column;
        }
      }
    </style>
  </body>
</html>
