---
import AppLayout from '../layouts/AppLayout.astro';
import Card from '../components/ui/Card.astro';
import Badge from '../components/ui/Badge.astro';
import Button from '../components/ui/Button.astro';
import Icon from '../components/ui/Icon.astro';
import DetectionOverlay from '../components/monitoring/DetectionOverlay.astro';
import SiteMap2D from '../components/spatial/SiteMap2D.astro';
import { mockMetrics, mockCameras, mockIncidents } from '../lib/mockData';

const criticalIncident = mockIncidents[0]; // INC-2026-0881
const primaryCamera = mockCameras[0]; // CAM-014
---

<AppLayout title="Operational Command Center" currentPath="/dashboard">
  <!-- Top Command Header / Breadcrumbs -->
  <div class="command-top-bar">
    <div class="command-title-group">
      <div class="site-tag">
        <span class="badge-dot" style="background: var(--color-safe);"></span>
        <span class="text-metadata">ACTIVE PROJECT: SKYLINE TOWER ALPHA</span>
      </div>
      <h1 class="text-page-title">Command Center Overview</h1>
    </div>

    <div class="top-action-group">
      <Button href="/live-monitoring" variant="secondary" size="sm">
        <Icon name="video" size={14} />
        Live Wall (18 Feeds)
      </Button>
      <Button href="/incidents" variant="secondary" size="sm">
        <Icon name="shield-alert" size={14} />
        Incident Log ({mockIncidents.length})
      </Button>
      <Button href="/reports" variant="primary" size="sm">
        <Icon name="bar-chart" size={14} />
        Shift Compliance
      </Button>
    </div>
  </div>

  <!-- Priority 3.5: Active Critical Incident Interrupt Banner -->
  <section class="critical-interrupt-banner" role="alert" aria-live="assertive" id="banner-critical-incident">
    <div class="banner-left">
      <div class="banner-icon-box">
        <Icon name="alert-triangle" size={24} color="#FFFFFF" />
      </div>
      <div class="banner-text">
        <div class="banner-meta-row">
          <Badge variant="critical" text="CRITICAL SAFETY INTERRUPT" />
          <span class="text-metadata">{criticalIncident.id}</span>
          <span class="banner-divider">•</span>
          <span class="text-metadata">{criticalIncident.location}</span>
          <span class="banner-divider">•</span>
          <span class="text-metadata">{criticalIncident.timestamp}</span>
        </div>
        <h2 class="banner-title">{criticalIncident.title}</h2>
        <p class="banner-recommendation">
          <strong>Recommended Action:</strong> {criticalIncident.recommendedAction}
        </p>
      </div>
    </div>

    <div class="banner-actions">
      <Button
        id="btn-ack-critical"
        variant="danger"
        size="md"
        type="button"
      >
        <Icon name="check" size={16} />
        Acknowledge Alert
      </Button>
      <Button href={`/incidents/${criticalIncident.id}`} variant="secondary" size="md">
        Investigate Workspace
        <Icon name="arrow-right" size={14} />
      </Button>
    </div>
  </section>

  <!-- First Visual Layer: 5 Operational KPIs (Priority 3.3) -->
  <section class="kpi-grid" aria-label="Operational KPI Summary">
    <!-- 1. Cameras Online -->
    <div class="kpi-card panel">
      <div class="kpi-header">
        <span class="text-metadata">CAMERAS ONLINE</span>
        <Icon name="camera" size={16} color="#3B82F6" />
      </div>
      <div class="kpi-value-row">
        <span class="kpi-number">{mockMetrics.camerasOnline}</span>
        <span class="kpi-total">/ {mockMetrics.totalCameras}</span>
      </div>
      <div class="kpi-footer">
        <Badge variant="safe" text="98.6% UPTIME" showDot={true} />
        <span class="text-caption">2 offline (B2/Pump)</span>
      </div>
    </div>

    <!-- 2. Active Risks -->
    <div class="kpi-card panel">
      <div class="kpi-header">
        <span class="text-metadata">ACTIVE RISKS</span>
        <Icon name="alert-triangle" size={16} color="#F59E0B" />
      </div>
      <div class="kpi-value-row">
        <span class="kpi-number text-warning">{mockMetrics.activeRisks}</span>
        <span class="kpi-total">ZONES</span>
      </div>
      <div class="kpi-footer">
        <Badge variant="warning" text="ELEVATED" showDot={true} />
        <span class="text-caption">1 Crane, 1 Pit Edge</span>
      </div>
    </div>

    <!-- 3. Critical Incidents -->
    <div class="kpi-card panel">
      <div class="kpi-header">
        <span class="text-metadata">CRITICAL INCIDENTS</span>
        <Icon name="shield-alert" size={16} color="#EF4444" />
      </div>
      <div class="kpi-value-row">
        <span class="kpi-number text-critical">{mockMetrics.criticalIncidents}</span>
        <span class="kpi-total">UNRESOLVED</span>
      </div>
      <div class="kpi-footer">
        <Badge variant="critical" text="ACTION REQUIRED" showDot={true} />
        <span class="text-caption">Avg response: 42s</span>
      </div>
    </div>

    <!-- 4. Workers Detected -->
    <div class="kpi-card panel">
      <div class="kpi-header">
        <span class="text-metadata">WORKERS DETECTED</span>
        <Icon name="users" size={16} color="#38BDF8" />
      </div>
      <div class="kpi-value-row">
        <span class="kpi-number">{mockMetrics.workersDetected}</span>
        <span class="kpi-total">HEADCOUNT</span>
      </div>
      <div class="kpi-footer">
        <Badge variant="info" text="ANONYMIZED ID" showDot={false} />
        <span class="text-caption">Active on 4 levels</span>
      </div>
    </div>

    <!-- 5. Safety Compliance -->
    <div class="kpi-card panel">
      <div class="kpi-header">
        <span class="text-metadata">SAFETY COMPLIANCE</span>
        <Icon name="shield-check" size={16} color="#10B981" />
      </div>
      <div class="kpi-value-row">
        <span class="kpi-number text-safe">{mockMetrics.safetyCompliancePercent}%</span>
        <span class="kpi-total">TARGET 95%</span>
      </div>
      <div class="kpi-footer">
        <Badge variant="safe" text="+1.4% VS YESTERDAY" showDot={false} />
        <span class="text-caption">PPE verification 99%</span>
      </div>
    </div>
  </section>

  <!-- Main Operational Split: Live Monitoring Preview + 2D Site Map -->
  <div class="main-operational-split">
    <!-- Left: Large Live Feed Preview (CAM-014) with AI Overlays -->
    <Card title="Live Priority Feed: CAM-014 (Tower Crane North)" subtitle="SECTOR 4 • 4K REALTIME STREAM • 48MS INFERENCE" badge="CRITICAL DETECTED" badgeVariant="critical" class="live-stream-panel">
      <div class="camera-feed-box">
        <img
          src="/assets/evidence-helmet-crane.svg"
          alt="Live RTSP video feed showing tower crane radius and AI bounding box overlay"
          class="feed-canvas"
        />

        <!-- Active Computer Vision Overlays -->
        <DetectionOverlay detections={criticalIncident.detections} cameraName={primaryCamera.name} />

        <!-- Camera HUD Controls -->
        <div class="camera-hud-bottom">
          <div class="hud-badges">
            <span class="hud-pill">FPS: 30.0</span>
            <span class="hud-pill">BITRATE: 4.8 Mbps</span>
            <span class="hud-pill">LATENCY: 142ms</span>
          </div>
          <div class="hud-buttons">
            <a href={`/incidents/${criticalIncident.id}`} class="btn btn-danger btn-sm">
              <Icon name="shield-alert" size={12} />
              Open Investigation
            </a>
            <a href="/live-monitoring" class="btn btn-secondary btn-sm">
              <Icon name="maximize" size={12} />
              Expand Fullscreen
            </a>
          </div>
        </div>
      </div>
    </Card>

    <!-- Right: 2D Spatial Topological Map & Active Zones -->
    <Card title="Jobsite Spatial Plan & Zone Health" subtitle="NORMALIZED 2D TOPOLOGICAL GRID • 18 CAMERAS LOCATED" badge="LIVE SYNCHRONIZED" badgeVariant="safe" class="spatial-plan-panel">
      <SiteMap2D height="360px" activeCameraId="CAM-014" />
      <div class="spatial-legend">
        <div class="legend-item">
          <span class="legend-box danger"></span>
          <span>Crane Swing Danger</span>
        </div>
        <div class="legend-item">
          <span class="legend-box warning"></span>
          <span>Trench Buffer</span>
        </div>
        <div class="legend-item">
          <span class="legend-box info"></span>
          <span>PPE Verified Gate</span>
        </div>
        <a href="/zones" class="legend-link">Edit Zones →</a>
      </div>
    </Card>
  </div>

  <!-- Lower Section: Recent Incidents Table & Quick Actions -->
  <div class="lower-operational-split">
    <!-- Incident List Table -->
    <Card title="Active Incident Queue" subtitle="CHRONOLOGICAL PRIORITY LOG" badge={`${mockIncidents.length} TOTAL`} badgeVariant="warning" class="incidents-panel">
      <div class="table-container">
        <table class="operational-table" aria-label="Recent Safety Incidents">
          <thead>
            <tr>
              <th>Incident</th>
              <th>Location</th>
              <th>Camera</th>
              <th>Timestamp</th>
              <th>Status</th>
              <th>Action</th>
            </tr>
          </thead>
          <tbody>
            {mockIncidents.map((inc) => (
              <tr>
                <td>
                  <div class="incident-name-cell">
                    <img src={inc.evidenceThumbnail} alt="" class="table-thumb" width="40" height="24" />
                    <div>
                      <a href={`/incidents/${inc.id}`} class="incident-link">{inc.title}</a>
                      <p class="text-caption" style="font-family: var(--font-mono);">{inc.id}</p>
                    </div>
                  </div>
                </td>
                <td>{inc.location}</td>
                <td>
                  <span class="text-metadata">{inc.cameraId}</span>
                </td>
                <td>
                  <span class="text-metadata">{inc.timestamp.split(' ')[1]}</span>
                </td>
                <td>
                  <Badge
                    variant={inc.severity}
                    text={inc.status.replace('_', ' ')}
                  />
                </td>
                <td>
                  <Button href={`/incidents/${inc.id}`} variant="secondary" size="sm">
                    View
                  </Button>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </Card>

    <!-- Quick Operations & Dispatch Rail -->
    <Card title="Quick Operational Actions" subtitle="FIELD DISPATCH & SITE CONTROLS" class="quick-actions-panel">
      <div class="quick-actions-list">
        <button type="button" class="action-tile" id="btn-broadcast-alert">
          <div class="action-icon alert">
            <Icon name="alert-triangle" size={18} color="#EF4444" />
          </div>
          <div class="action-info">
            <span class="action-title">Broadcast Zone 8 Audio Warning</span>
            <span class="action-desc">Trigger loud speaker horn at North Tower Level 08</span>
          </div>
          <Icon name="arrow-right" size={14} color="#64748B" />
        </button>

        <button type="button" class="action-tile" id="btn-radio-marshal">
          <div class="action-icon info">
            <Icon name="users" size={18} color="#3B82F6" />
          </div>
          <div class="action-info">
            <span class="action-title">Dispatch Marshal Vance (Ch. 2)</span>
            <span class="action-desc">Push automated radio dispatch to Sector 4 lead</span>
          </div>
          <Icon name="arrow-right" size={14} color="#64748B" />
        </button>

        <button type="button" class="action-tile" id="btn-crane-hold">
          <div class="action-icon warning">
            <Icon name="sliders" size={18} color="#F59E0B" />
          </div>
          <div class="action-info">
            <span class="action-title">Request Crane Operator Hold</span>
            <span class="action-desc">Transmit yellow telemetry signal to Cab 1</span>
          </div>
          <Icon name="arrow-right" size={14} color="#64748B" />
        </button>

        <a href="/reports" class="action-tile">
          <div class="action-icon safe">
            <Icon name="bar-chart" size={18} color="#10B981" />
          </div>
          <div class="action-info">
            <span class="action-title">Generate Shift Handover Report</span>
            <span class="action-desc">Export verified OSHA compliance audit log</span>
          </div>
          <Icon name="arrow-right" size={14} color="#64748B" />
        </a>
      </div>
    </Card>
  </div>

  <script>
    // Acknowledge Banner Quick Action
    const ackBtn = document.getElementById('btn-ack-critical');
    const banner = document.getElementById('banner-critical-incident');

    ackBtn?.addEventListener('click', () => {
      ackBtn.innerHTML = '<span>Acknowledged ✓</span>';
      (ackBtn as HTMLButtonElement).disabled = true;
      if (typeof (window as any).showToast === 'function') {
        (window as any).showToast('Incident INC-2026-0881 acknowledged by Marshal Vance.', 'safe');
      }
      setTimeout(() => {
        if (banner) {
          banner.style.opacity = '0.7';
          banner.style.borderColor = 'var(--color-safe)';
        }
      }, 500);
    });

    // Quick Action button toast triggers
    document.getElementById('btn-broadcast-alert')?.addEventListener('click', () => {
      (window as any).showToast('Audio warning broadcast transmitted to Zone 8 Horn.', 'critical');
    });
    document.getElementById('btn-radio-marshal')?.addEventListener('click', () => {
      (window as any).showToast('Radio dispatch sent to Marshal Vance on Ch. 2.', 'info');
    });
    document.getElementById('btn-crane-hold')?.addEventListener('click', () => {
      (window as any).showToast('Crane Cab 1 received operation hold request.', 'warning');
    });
  </script>
</AppLayout>

<style>
  .command-top-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-6);
    flex-wrap: wrap;
    gap: var(--space-4);
  }
  .command-title-group {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .site-tag {
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .top-action-group {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  /* Critical Interrupt Banner (Priority 3.5) */
  .critical-interrupt-banner {
    background: var(--color-critical-dark);
    border: 2px solid var(--color-critical);
    border-radius: var(--radius-lg);
    padding: var(--space-4) var(--space-6);
    margin-bottom: var(--space-6);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    box-shadow: 0 0 20px rgba(239, 68, 68, 0.25);
    flex-wrap: wrap;
    transition: all var(--duration-fast);
  }
  .banner-left {
    display: flex;
    align-items: flex-start;
    gap: var(--space-4);
  }
  .banner-icon-box {
    width: 44px;
    height: 44px;
    background: var(--color-critical);
    border-radius: var(--radius-md);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .banner-text {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .banner-meta-row {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .banner-divider {
    color: rgba(255, 255, 255, 0.4);
    font-size: 10px;
  }
  .banner-title {
    font-size: var(--font-size-md);
    font-weight: 700;
    color: #FFFFFF;
  }
  .banner-recommendation {
    font-size: var(--font-size-xs);
    color: #FECACA;
  }
  .banner-actions {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  /* First Visual Layer: 5 KPI Cards */
  .kpi-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: var(--space-4);
    margin-bottom: var(--space-6);
  }
  .kpi-card {
    padding: var(--space-4);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .kpi-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .kpi-value-row {
    display: flex;
    align-items: baseline;
    gap: 6px;
  }
  .kpi-number {
    font-family: var(--font-display);
    font-size: 1.875rem;
    font-weight: 800;
    color: #FFFFFF;
    line-height: 1;
  }
  .kpi-total {
    font-family: var(--font-mono);
    font-size: var(--font-size-xs);
    color: var(--color-text-muted);
  }
  .kpi-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 4px;
  }

  .text-warning {
    color: var(--color-warning-light) !important;
  }
  .text-critical {
    color: var(--color-critical-light) !important;
  }
  .text-safe {
    color: var(--color-safe-light) !important;
  }

  /* Main Operational Split */
  .main-operational-split {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: var(--space-6);
    margin-bottom: var(--space-6);
  }
  .camera-feed-box {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    background: #020617;
    border-radius: var(--radius-sm);
    overflow: hidden;
  }
  .feed-canvas {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .camera-hud-bottom {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 8px 12px;
    background: linear-gradient(to top, rgba(11, 18, 32, 0.95), transparent);
    display: flex;
    align-items: center;
    justify-content: space-between;
    z-index: 10;
  }
  .hud-badges {
    display: flex;
    gap: 6px;
  }
  .hud-pill {
    background: rgba(0, 0, 0, 0.6);
    border: 1px solid var(--color-border);
    padding: 2px 6px;
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--color-text-secondary);
    border-radius: var(--radius-xs);
  }
  .hud-buttons {
    display: flex;
    gap: 6px;
  }

  .spatial-legend {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    margin-top: var(--space-3);
    padding-top: var(--space-2);
    border-top: 1px solid var(--color-border);
    font-size: 11px;
    color: var(--color-text-secondary);
  }
  .legend-item {
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .legend-box {
    width: 12px;
    height: 8px;
    border-radius: 2px;
  }
  .legend-box.danger {
    background: rgba(239, 68, 68, 0.3);
    border: 1px solid #EF4444;
  }
  .legend-box.warning {
    background: rgba(245, 158, 11, 0.3);
    border: 1px solid #F59E0B;
  }
  .legend-box.info {
    background: rgba(59, 130, 246, 0.3);
    border: 1px solid #3B82F6;
  }
  .legend-link {
    margin-left: auto;
    color: var(--color-info-light);
    font-weight: 600;
  }

  /* Lower Operational Split */
  .lower-operational-split {
    display: grid;
    grid-template-columns: 1.6fr 1fr;
    gap: var(--space-6);
  }
  .table-container {
    overflow-x: auto;
  }
  .operational-table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--font-size-xs);
  }
  .operational-table th, .operational-table td {
    padding: 10px 12px;
    text-align: left;
    border-bottom: 1px solid var(--color-border);
  }
  .operational-table th {
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 600;
  }
  .incident-name-cell {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }
  .table-thumb {
    border-radius: var(--radius-xs);
    border: 1px solid var(--color-border);
    object-fit: cover;
  }
  .incident-link {
    font-weight: 600;
    color: var(--color-text-primary);
  }
  .incident-link:hover {
    color: var(--color-info-light);
  }

  .quick-actions-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .action-tile {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: 10px 12px;
    background: var(--color-surface-elevated);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    text-align: left;
    cursor: pointer;
    transition: all var(--duration-fast);
  }
  .action-tile:hover {
    background: var(--color-surface-hover);
    border-color: var(--color-border-active);
  }
  .action-icon {
    width: 32px;
    height: 32px;
    border-radius: var(--radius-sm);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .action-icon.alert {
    background: rgba(239, 68, 68, 0.15);
  }
  .action-icon.info {
    background: rgba(59, 130, 246, 0.15);
  }
  .action-icon.warning {
    background: rgba(245, 158, 11, 0.15);
  }
  .action-icon.safe {
    background: rgba(16, 185, 129, 0.15);
  }
  .action-info {
    flex: 1;
    display: flex;
    flex-direction: column;
  }
  .action-title {
    font-size: var(--font-size-xs);
    font-weight: 600;
    color: var(--color-text-primary);
  }
  .action-desc {
    font-size: 11px;
    color: var(--color-text-muted);
  }

  @media (max-width: 1280px) {
    .kpi-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (max-width: 1024px) {
    .kpi-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .main-operational-split,
    .lower-operational-split {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .kpi-grid {
      grid-template-columns: 1fr;
    }
    .critical-interrupt-banner {
      flex-direction: column;
      align-items: stretch;
    }
  }
</style>
